{
  "opencollection": "1.0.0",
  "info": {
    "name": "Parcha Admin Image Proxy API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Image Proxy",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Image",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.parcha.ai/api/v1/image-proxy",
            "params": [
              {
                "name": "url",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Proxy to load an image from an external URL and return the image content.\n\nArgs:\n- url: str : The URL of the image to load.\n\nReturns:\n- StreamingResponse : The image content streamed back to the client."
        }
      ]
    }
  ],
  "bundled": true
}