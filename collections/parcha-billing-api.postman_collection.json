          "id": "090ac897-8124-4ddf-97a9-4acc7a7974fa",
          "name": "Reconcile Billing Events",
          "request": {
            "name": "Reconcile Billing Events",
            "description": {
              "content": "Reconcile Stripe events with local database for the specified lookback period.\n\nThis endpoint fetches Stripe events for the specified period and verifies that they have been\nproperly processed and applied to the local database. It can identify and fix:\n\n- Missing subscription records\n- Incorrect plan assignments\n- Missing payment/invoice activities\n- Orphaned subscription records\n- Credit balance mismatches\n\nArgs:\n    lookback_days: Number of days to look back for events (max 30 due to Stripe API limitations)\n    include_processed: Whether to include already processed events (default: False)\n\nReturns:\n    Detailed reconciliation report with found issues and fixes applied",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "billing",
                "reconcile"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lookback_days",
                  "value": "7",
                  "description": "Number of days to look back (1-30)"
                },
                {
                  "disabled": false,
                  "key": "include_processed",
                  "value": "false",
                  "description": "Whether to include already processed events in reconciliation"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
