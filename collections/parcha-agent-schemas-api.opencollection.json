{
  "opencollection": "1.0.0",
  "info": {
    "name": "Parcha Admin Agent Schemas API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Agent Schemas",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get agent schemas",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.parcha.ai/api/v1/agent-schemas/:agent_key",
            "params": [
              {
                "name": "agent_key",
                "value": "",
                "type": "path",
                "description": "The agent key"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the schema information for all checks in an agent"
        }
      ]
    }
  ],
  "bundled": true
}